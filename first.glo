#import "Compiler";
#import "File_System/Path";
#import "Format";
#import "Io";

#comptime {
    set_current_output(false);
    directory := path_dirname(#source_location.filename);

    profile := Build_Profile.create("rne");
    options := profile.options();

    options.output_directory = tprint("{}/build", directory);
    options.output_name = "rne";
    options.optimization_level = .O3;

    profile.set_options(options);

    if compile_file(tprint("{}/main.glo", directory), profile) == {
        case .Ok(log);
            print("{}", log);
        case .Err(error);
            print("{}\n", error.message);
            exit(error.status);
    }
    print("rne: {}/build/rne\n", directory);
}

main :: () {}
