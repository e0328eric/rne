#import "../App.glo";
#import "../Rename.glo";
#import "../Ui.glo";
#import "Terminal";
#import "Terminal/Text_Input";
#import "Command_Line";
#import "String_Builder";
#import "Strings/Utf8";
#import "Io";
#import "Os";

check :: (condition: bool, message: str) {
    if !condition {
        print("FAIL: {}\n", message);
        exit(1);
    }
}
screen :: (app: *Rne_App, width: ssize = 120, height: ssize = 32) -> str {
    canvas := Terminal_Canvas.terminal_canvas_init(width, height);
    defer canvas.free();
    _ = rne_render(app, &canvas);
    out: String_Builder;
    for y: 0..canvas.height {
        for x: 0..canvas.width {
            cell := canvas.cells[y * canvas.width + x];
            if cell.width > 0 out.write_rune(cast(rune) cell.rune);
        }
        out.write_byte(10);
    }
    return out.into_string();
}
shows :: (app: *Rne_App, expected: str, width: ssize = 120, height: ssize = 32) {
    text := screen(app, width, height);
    defer text.free();
    if !text.contains(expected) {
        print("Expected [{}] in:\n{}", expected, text);
        check(false, "capture preview");
    }
}
key :: (app: *Rne_App, code: Terminal_Key_Code) {
    check(!rne_key(app, .{ .code = code }, 10), "UI keys do not quit");
}
check_review_keys :: (root: str) {
    app: Rne_App;
    defer app.free();
    check(rne_initialize(&app, root), "load review fixture");
    app.replacement.set_text("renamed");
    for focus: .[Rne_Focus.Search, Rne_Focus.Replace, Rne_Focus.Files] {
        for shortcut: .[Terminal_Key_Code.F9, Terminal_Key_Code.Enter] {
            app.search.set_text("no matching files");
            rne_recompute(&app);
            check(app.pending == 0, "initial preview has no changes");
            // Review must pick up input changes even before a preview refresh.
            app.search.set_text("2번");
            app.focus = focus;
            app.command = 1;
            selected := app.selected;
            key(&app, shortcut);
            check(app.modal == .Confirm && app.pending == 2, "review uses the current Find text");
            check(app.command == 0, "review starts with Cancel selected");
            check(app.focus == focus, "review does not change focus");
            check(app.selected == selected, "Enter does not toggle file selection");
            for width: .[52, 84, 120] {
                shows(&app, "REVIEW YOUR CHANGESET", width, 20);
                shows(&app, "F9 / Enter", width, 20);
            }
            check(!rne_key(&app, .{ .code = .Enter, .rune = 13, .pasted = true }, 10),
                "pasted Enter does not quit");
            check(app.modal == .Confirm && app.last_applied == 0, "pasted Enter cannot confirm");
            key(&app, .Enter);
            check(app.modal == .None && app.last_applied == 0, "default Enter cancels review");
        }
    }
    for shortcut: .[Terminal_Key_Code.F9, Terminal_Key_Code.Enter] {
        app.focus = .Search;
        app.options.regex = true;
        app.search.set_text("2번");
        app.replacement.set_text("renamed");
        rne_recompute(&app);
        app.search.set_text("[");
        key(&app, shortcut);
        check(app.modal == .None && !app.regex_valid, "invalid edits cannot review a stale plan");
        app.search.set_text("2번");
        app.replacement.set_text("../invalid");
        key(&app, shortcut);
        check(app.modal == .None && app.blocked == 2, "blocked edits cannot open review");
        app.search.set_text("no matching files");
        key(&app, shortcut);
        check(app.modal == .None && app.status == "No changes to apply.", "empty plans report why");
        check(!rne_key(&app, .{ .code = shortcut, .pasted = true }, 10), "pasted shortcuts do not quit");
        check(app.modal == .None, "pasted shortcuts cannot open review");
    }
}
main :: () {
    args := get_cmdline_args();
    check_review_keys(args[1]);
    app: Rne_App;
    defer app.free();
    app.options.regex = true;
    app.search.set_text("2번 배우 (?<person>\\w+) \\((\\d+)\\)\\.png");
    app.replacement.set_text("$1_$2_${start=0,padding=1}.png");
    check(rne_initialize(&app, args[1]), "load fixture");
    check(app.files[1].new_name == "고세구_1_0.png", "nonmatches do not count");
    check(app.files[2].new_name == "고세구_2_1.png", "matching files increment");
    app.files[1].selected = false;
    rne_recompute(&app);
    check(app.files[2].new_name == "고세구_2_0.png", "excluded matches do not count");
    shows(&app, "$2=\"2\"");
    app.files[1].selected = true;
    rne_recompute(&app);
    for width: .[52, 68, 84, 120, 140] {
        shows(&app, "$1=\"고세구\"", width, 20);
        shows(&app, "F2 groups", width, 20);
        shows(&app, "F9", width, 20);
    }
    key(&app, .F2);
    shows(&app, "CAPTURE GROUPS");
    shows(&app, "2번 배우 고세구 (1).png");
    shows(&app, "$0 (whole match) = \"2번 배우 고세구 (1).png\"");
    shows(&app, "$1 / ${person} = \"고세구\"");
    shows(&app, "$2 = \"1\"");
    key(&app, .Escape);
    check(app.modal == .None, "Escape closes capture details");
    app.focus = .Files;
    app.cursor = 2;
    shows(&app, "$2=\"2\"");
    key(&app, .F2);
    shows(&app, "$2 = \"2\"");
    key(&app, .F2);
    check(app.modal == .None, "F2 toggles capture details");
    app.cursor = 0;
    shows(&app, "No match in this filename.");
    key(&app, .F2);
    shows(&app, "1-unrelated.txt");
    shows(&app, "No match in this filename.");
    key(&app, .Enter);
    app.focus = .Search;
    app.search.set_text("^(2번) (?:배우 )(?<person>고세구)(x)?()");
    rne_recompute(&app);
    shows(&app, "$1=\"2번\"");
    shows(&app, "$3=(unmatched)");
    key(&app, .F2);
    shows(&app, "$2 / ${person} = \"고세구\"");
    shows(&app, "$3 = (unmatched)");
    shows(&app, "$4 = \"\"");
    key(&app, .Escape);
    app.search.set_text("2번 배우 고세구 \\(\\d+\\)\\.png");
    rne_recompute(&app);
    shows(&app, "No capture groups; use (...) for $1.");
    key(&app, .F2);
    shows(&app, "$0 (whole match)");
    shows(&app, "\\( and \\) match literal parentheses.");
    key(&app, .Escape);
    app.options.scope = .Extension;
    app.search.set_text("(png)");
    rne_recompute(&app);
    shows(&app, "$1=\"png\"");
    key(&app, .F2);
    shows(&app, "First match · Extension");
    shows(&app, "$0 (whole match) = \"png\"");
    key(&app, .Escape);
    app.options.scope = .Whole;
    app.search.set_text("[");
    rne_recompute(&app);
    shows(&app, "Fix the Find pattern to preview captures.");
    key(&app, .F2);
    shows(&app, "Fix the Find pattern to preview captures.");
    key(&app, .Escape);
    app.search.set_text("");
    rne_recompute(&app);
    shows(&app, "Use (...) in Find to capture text as $1.");
    app.options.regex = false;
    rne_recompute(&app);
    key(&app, .F2);
    shows(&app, "Enable regex with Ctrl+R to inspect captures.");
    key(&app, .Escape);
    app.options.regex = true;
    app.search.set_text(
        "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)(m)(n)(o)(p)(q)(r)(s)(t)(u)(v)(w)(x)(y)(z)"
    );
    rne_recompute(&app);
    key(&app, .F2);
    key(&app, .End);
    shows(&app, "$26 = \"z\"", 52, 20);
    key(&app, .Home);
    shows(&app, "$1 = \"a\"", 52, 20);
    key(&app, .Page_Down);
    shows(&app, "$10 = \"j\"", 52, 20);
    key(&app, .Escape);
    print("Review shortcuts, capture UI and selection checks passed\n");
}
